{
  "name": "smart-home-api",
  "version": "1.0.0",
  "description": "Smart Home Devices REST API — Lab 4",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "imports": {
    "#constants": "./constants/index.js",
    "#controllers": "./controllers/deviceController.js",
    "#routes": "./routes/deviceRoutes.js",
    "#schemas/device": "./schemas/device.schema.js",
    "#services": "./services/deviceService.js",
    "#repositories": "./repositories/deviceRepository.js",
    "#utils": "./utils/index.js"
  },
  "scripts": {
    "start": "node server.js",
    "predev": "npm run check",
    "dev": "nodemon --env-file=.env server.js",
    "external": "json-server db.json --port 3001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:force": "node --env-file=.env scripts/seed.js --force",
    "migrate": "node --env-file=.env db/init.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.22.2"
  },
  "devDependencies": {
    "@eslint/js": "~9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.0.0",
    "json-server": "^1.0.0-beta.15",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0"
  }
}
