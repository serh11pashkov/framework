          "description": "Execute this sequence to test complete authentication flow:\n1. Create new user account\n2. Login and get access token\n3. View user profile\n4. Create protected resource\n5. Logout (blacklist token)\n6. Verify token no longer works"
        },
        {
          "name": "Scenario 2: Token Expiration & Refresh",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPassword123\"\n}"
                },
                "url": {
                  "raw": "http://localhost:3000/auth/login",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "3000",
                  "path": ["auth", "login"]
                }
              }
            },
            {
              "name": "Use Protected Route (token valid)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"device\": \"Lamp\",\n  \"status\": \"on\",\n  \"room\": \"Bedroom\"\n}"
                },
                "url": {
                  "raw": "http://localhost:3000/api/v2/items",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "3000",
                  "path": ["api", "v2", "items"]
                }
              }
            },
            {
              "name": "Wait (simulating token expiration)",
              "description": "In real scenario, wait 15 minutes for token to expire. For testing, proceed to refresh."
            },
            {
              "name": "Refresh Access Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "http://localhost:3000/auth/refresh",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "3000",
                  "path": ["auth", "refresh"]
                }
              }
            },
            {
              "name": "Use Protected Route Again (new token)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "http://localhost:3000/auth/me",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "3000",
                  "path": ["auth", "me"]
                }
              }
            }
          ],
          "description": "Test the token refresh workflow:\n1. Login to get initial access token (15 min TTL)\n2. Use protected route successfully\n3. When token expires, call /auth/refresh\n4. Receive new access token\n5. Use protected route with new token"
        }
      ]
    }
  ]
}
