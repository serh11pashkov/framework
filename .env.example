PORT=3000
HOSTNAME=127.0.0.1
NODE_ENV=development
ADMIN_API_KEY=change-me

# Optional: external reference API for /api/v1/items/:id/details
EXTERNAL_BASE_URL=http://localhost:3001/deviceTypes

# Optional: GitHub API token to avoid strict rate limits on shared-repos endpoints
# Create token: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=ghp_your_token_here

